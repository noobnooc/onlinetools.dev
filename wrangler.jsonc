{
	// Cloudflare Workers configuration for onlinetools.dev
	// Uses Workers Static Assets via @sveltejs/adapter-cloudflare.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "onlinetools-dev",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-07-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// Production serves on the custom domain only; workers.dev is disabled
	// for the deployed version but preview URLs stay on for branch builds.
	"routes": [
		{ "pattern": "onlinetools.dev", "custom_domain": true },
		{ "pattern": "www.onlinetools.dev", "custom_domain": true }
	],
	"workers_dev": false,
	"preview_urls": true,
	"observability": {
		"enabled": true
	}
}
